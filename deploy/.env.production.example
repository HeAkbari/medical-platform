# Copy to deploy/.env on the VPS and adjust if ports conflict with other apps.
#
#   cp deploy/.env.production.example deploy/.env

# Host ports (change if already in use on the VPS)
WEB_HOST_PORT=3002
HAPI_HOST_PORT=8082

# HAPI PostgreSQL password (change in production)
HAPI_DB_PASSWORD=hapi

# JVM heap for HAPI on small VPS (increase if server has 4GB+ RAM)
HAPI_JAVA_OPTS=-Xms256m -Xmx768m

# Session cookie Secure flag — false for http://IP:port; true after HTTPS
SESSION_COOKIE_SECURE=false

# --- Platform database (ClinicCredential, Facility, Doctor, Patient, ---
# --- PatientAccount, AuthSession, ...) — see packages/db.              ---

# Password for the app-postgres container (change from this placeholder).
APP_DB_PASSWORD=

# 32-byte hex key for ClinicCredential's AES-256-GCM encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT key than any dev environment's — never share across envs.
CREDENTIALS_ENCRYPTION_KEY=

# clinicId row in ClinicCredential to use (pilot: one clinic).
OSCAR_CLINIC_ID=sponsor-clinic

# mock | fhir | oscar — sponsor clinic production reads live OSCAR data.
DATA_SOURCE=oscar

# --- Google Sign-In ---
# OAuth 2.0 Client ID (Web application) from Google Cloud Console. Add this
# deploy's public origin (e.g. http://YOUR_IP:3002) to the client's
# "Authorized JavaScript origins" in Google Cloud Console, or the Sign-In
# button will fail with an origin-mismatch error. No client secret needed —
# we only verify ID tokens, not the auth-code exchange.
GOOGLE_CLIENT_ID=
