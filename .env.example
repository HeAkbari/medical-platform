# Medical Platform — environment template

# Web
NEXT_PUBLIC_API_URL=/api

# Data source: "mock" (default, in-memory) or "fhir" (FHIR R4 server).
# For phase 1 testing, point at the local HAPI FHIR server (docs/oscar).
# For phase 2, swap FHIR_BASE_URL/FHIR_TOKEN for the OSCAR sandbox.
DATA_SOURCE=mock
FHIR_BASE_URL=http://localhost:8080/fhir
# FHIR_TOKEN=

# Platform database (ClinicCredential, Facility, Doctor, ...).
# Start it locally with: docker compose -f deploy/docker-compose.dev.yml up -d
DATABASE_URL=postgresql://medical_platform:medical_platform@localhost:5432/medical_platform
# 32-byte hex key for ClinicCredential's AES-256-GCM encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# API (when NestJS backend is implemented)
NODE_ENV=development
PORT=3000
REDIS_URL=redis://localhost:6379
