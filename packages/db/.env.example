# Prisma CLI env (packages/db). Copy to .env for local dev:
#   cp packages/db/.env.example packages/db/.env
#
# Points at the local app Postgres started via deploy/docker-compose.dev.yml.
DATABASE_URL=postgresql://medical_platform:medical_platform@localhost:5432/medical_platform

# Master encryption key for ClinicCredential (AES-256-GCM), 32 bytes hex-encoded.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value — this must match between seeding and runtime decryption.
CREDENTIALS_ENCRYPTION_KEY=

# Only needed to run `bun run db:seed:clinic-credential` (one-off, per clinic).
# Fill these from the sponsor clinic's Postman environment after the manual
# OAuth1 three-legged handshake has produced accessToken/accessTokenSecret.
SEED_CLINIC_ID=
SEED_EMR_TYPE=oscar
SEED_OSCAR_BASE_URL=
SEED_CONSUMER_KEY=
SEED_CONSUMER_SECRET=
SEED_ACCESS_TOKEN=
SEED_ACCESS_TOKEN_SECRET=
# Set to "true" only if this clinic's OSCAR install serves a self-signed TLS
# cert (known sandbox quirk) — never for a real clinic with a valid cert.
SEED_ALLOW_SELF_SIGNED_CERT=false
