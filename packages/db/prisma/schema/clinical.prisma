model Patient {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  // Only firstName/lastName are mandatory at registration (see
  // docs/oscar/new-approach/patient-clinic-linking-architecture.md) — DOB
  // and email are collected on profile completion, not at signup.
  dateOfBirth DateTime?
  email       String?   @unique
  phone       String
  // Platform-wide (not per-clinic, unlike PatientClinicIdentity.healthNumber
  // below): these belong to the person, not to their relationship with any
  // one clinic. Used to seed a new OSCAR Demographic when a patient is
  // provisioned into a clinic they don't already exist in — never used to
  // search/match (matching is by firstName+lastName, see
  // EnsurePatientLinkedToClinicUseCase).
  healthNumber String?
  addressLine  String?
  city         String?
  province     String?
  postalCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinicIdentities PatientClinicIdentity[]
}

// Doctor directory: platform-owned read model, periodically synced from each
// clinic's live EMR (DoctorRepository.findAll(), OSCAR or FHIR) — never
// queried live for browsing. Availability/booking stays fully live via the
// existing AppointmentRepository; this table is for Find Physician /
// Physician Info / rating display only. A doctor works at exactly one
// clinic (confirmed), so this platform id <-> (clinicId, externalProviderId)
// mapping is always 1:1. See
// docs/oscar/new-approach/docs-oscar-new-approach.md §5.
model Doctor {
  id                 String @id @default(uuid())
  clinicId           String
  externalProviderId String

  firstName  String
  lastName   String
  specialty  String
  email      String
  phone      String
  // Denormalized from Facility at sync time — left unset until ClinicCredential
  // rows are linked to a specific Facility (not the case yet, see design doc).
  clinicName String?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]

  @@unique([clinicId, externalProviderId])
}

// Individual rating/review. `source` distinguishes multiple review origins
// (patient-submitted, clinic-provided, AI-assisted, ...) sharing one table
// from day one, per design doc §5 — business rules (who can submit, how to
// aggregate across sources, abuse handling) are intentionally deferred.
// Average rating / count are computed on read, not stored redundantly.
model Review {
  id         String   @id @default(uuid())
  doctorId   String
  source     String
  rating     Int
  comment    String?
  authorName String?
  createdAt  DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

model Appointment {
  id              String   @id @default(uuid())
  patientId       String
  doctorId        String
  scheduledAt     DateTime
  durationMinutes Int
  status          String
  reason          String
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
