// Encrypted OAuth1 connection credentials for each clinic's EMR (OSCAR, FHIR, ...).
// Kept in its own table, separate from the (low-sensitivity) `Facility` data —
// see docs/oscar/new-approach/docs-oscar-new-approach.md section 7.
model ClinicCredential {
  id       String @id @default(uuid())
  clinicId String @unique
  emrType  String
  baseUrl  String

  // Some OSCAR installs (e.g. the sponsor clinic's sandbox) serve TLS with a
  // self-signed cert. Never default this true for a real production clinic
  // reachable over the internet — it disables MITM protection for that
  // connection specifically. Opt-in and per-clinic, not a global switch.
  allowSelfSignedCert Boolean @default(false)

  // AES-256-GCM ciphertext (iv + authTag + data, base64), decrypted only
  // server-side via packages/domain/src/adapters/platform/clinic-credentials.ts.
  consumerKeyEnc       String
  consumerSecretEnc    String
  accessTokenEnc       String
  accessTokenSecretEnc String

  // Separate credential pair for the clinic's legacy SOAP web services
  // (LoginService/ScheduleService/BookingService — a different auth scheme
  // entirely, WS-Security UsernameToken, not OAuth1). Nullable: only
  // populated for clinics where this SOAP layer is actually used (currently
  // just the doctor-schedule-template lookup). securityId/securityTokenKey
  // come from a one-time LoginService.login call with a dedicated
  // integration account (never a personal login). Stable only for the life
  // of OSCAR's Tomcat process — invalidated by a Tomcat restart (verified
  // 2026-09-29); refresh via prisma/encrypt-soap-credential.ts. See
  // docs/oscar/new-approach/oscar-soap-schedule-services.md.
  soapSecurityId          String?
  soapSecurityTokenKeyEnc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
